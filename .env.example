# Copiar para .env e ajustar. O .env nunca vai para o Git.

# Glob dos ficheiros Parquet da tabela de breaks (formato longo).
# Ex.: ficheiros copiados de T_AF_EMIR_RF_MATCHING, um por business date.
ODIN_BREAKS_GLOB=data/breaks/*.parquet

# Base DuckDB local gerada por `npm run build:db`.
ODIN_DB_PATH=data/odin.duckdb

# Só se BUSINESS_DATE vier como texto no Parquet (formato strptime do DuckDB).
# Ex.: %d/%m/%Y. Deixar vazio se a coluna já for DATE/TIMESTAMP.
ODIN_BUSINESS_DATE_FORMAT=

# Gateway LLM interno (fase 6–8 do plano; ainda não usado).
ODIN_LLM_GATEWAY_URL=
ODIN_LLM_API_KEY=
ODIN_LLM_MODEL=
