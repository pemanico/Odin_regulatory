# Copy to .env and adjust. The .env file never goes into Git.

# Glob of the breaks table Parquet files (long format).
# E.g. S3 copy in data/breaks/{asset_class}/{YYYY-MM-DD}/part-*.parquet (the ** matches the subfolders).
ODIN_BREAKS_GLOB=data/breaks/**/*.parquet

# Glob of the DTCC reconciliation file (wide format, TP1_/TP2_ pairs), same folder structure.
ODIN_DTCC_GLOB=data/dtcc/**/*.parquet

# Local DuckDB database created by `npm run build:db`.
ODIN_DB_PATH=data/odin.duckdb

# Only if BUSINESS_DATE comes as text in the Parquet (DuckDB strptime format).
# E.g. %d/%m/%Y. Leave empty if the column is already DATE/TIMESTAMP.
ODIN_BUSINESS_DATE_FORMAT=

# Business dates excluded from day-on-day comparisons (persistence, breaks_dod), comma-separated.
# Overrides "excludedDates" in config/default.json (2026-10-12, anomalous day). Empty = none (e.g. synthetic data).
# ODIN_EXCLUDED_DATES=

# Demo server (npm start). Listens on localhost only.
# ODIN_PORT=3001

# Internal LLM gateway (agent phase; not used yet).
ODIN_LLM_GATEWAY_URL=
ODIN_LLM_API_KEY=
ODIN_LLM_MODEL=
