{
  "_comment": "Suggested questions of screen 1 (chips). Each one = question in English -> expected structured request. It is also the AGENT TEST SET: the agent must translate the question into the same request. $date = business date selected in the UI. Initial version written by Claude (2026-10-20); to be replaced with the real questions from operations.",
  "questions": [
    { "id": "top10", "text": "Top 10 breaking fields", "request": { "metric": "top_fields", "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }] } },
    { "id": "dod", "text": "What changed since the previous day?", "request": { "metric": "breaks_dod", "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }], "limit": 20 } },
    { "id": "verdicts", "text": "Breaks by ESMA rules verdict", "request": { "metric": "rule_verdict", "dimensions": ["verdict"], "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }] } },
    { "id": "cpty_fields", "text": "In which fields is the error on the counterparty side?", "request": { "metric": "rule_verdict", "dimensions": ["breaking_field"], "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }, { "dimension": "verdict", "op": "eq", "value": "cpty_only" }], "limit": 20 } },
    { "id": "bnpp_fields", "text": "In which fields is the error on the BNPP side?", "request": { "metric": "rule_verdict", "dimensions": ["breaking_field"], "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }, { "dimension": "verdict", "op": "eq", "value": "bnpp_only" }], "limit": 20 } },
    { "id": "keys", "text": "Transactions by verdict", "request": { "metric": "key_verdict", "dimensions": ["key_verdict"], "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }] } },
    { "id": "combos", "text": "Most frequent field combinations", "request": { "metric": "field_combinations", "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }], "limit": 20 } },
    { "id": "combos_val", "text": "Which fields break together with VALUATION_AMT?", "request": { "metric": "field_combinations", "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }, { "dimension": "breaking_field", "op": "eq", "value": "VALUATION_AMT" }], "limit": 20 } },
    { "id": "cpty", "text": "Which counterparties have the most breaks?", "request": { "metric": "breaks_by_counterparty", "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }], "limit": 20 } },
    { "id": "cpty_ccy", "text": "Counterparties with the most VALUATION_CCY breaks", "request": { "metric": "breaks_by_counterparty", "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }, { "dimension": "breaking_field", "op": "eq", "value": "VALUATION_CCY" }], "limit": 20 } },
    { "id": "asset", "text": "Breaks by asset class", "request": { "metric": "breaks_by_field", "dimensions": ["asset_class"], "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }] } },
    { "id": "unexplained", "text": "Unexplained transactions by asset class", "request": { "metric": "key_verdict", "dimensions": ["asset_class"], "filters": [{ "dimension": "business_date", "op": "eq", "value": "$date" }, { "dimension": "key_verdict", "op": "eq", "value": "unexplained" }] } }
  ]
}
